# NetCheck Gaming Environment Configuration

# Frontend (apps/web)
VITE_API_URL=https://netcheck-api.your-subdomain.workers.dev
VITE_ENABLE_ANALYTICS=false

# Cloudflare Workers (apps/api - set via wrangler or GitHub Secrets)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
D1_DATABASE_ID=your_d1_database_id_here
